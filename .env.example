# Copy this file to .env and fill the blanks. Never commit .env (it holds secrets).
# The names below default to the base template, so a clone changes only the base id,
# the tokens, the Asana project, and the repo. Change a field name only if your base renames it.

# --- Airtable ---
# The base id, app... Leave it blank until you have one.
AIRTABLE_BASE_ID=
# airtable.com > Builder hub > Personal access tokens. Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=
AIRTABLE_TABLE_COMPONENTS=Components
AIRTABLE_TABLE_TESTS=Storybook Testing
AIRTABLE_FIELD_FIGMA=Figma
AIRTABLE_FIELD_DESIGN=Design
AIRTABLE_FIELD_COMMIT=Commit
AIRTABLE_FIELD_STORYBOOK=Storybook
AIRTABLE_FIELD_STAGING_URL=Staging URL
AIRTABLE_FIELD_PRODUCTION_URL=Production URL
AIRTABLE_FIELD_ASTRO=Astro Link
AIRTABLE_FIELD_DEVELOPMENT=Development
AIRTABLE_FIELD_SYNCHRONIZATION=Synchronization %
AIRTABLE_FIELD_TOTAL_TESTS=Total Tests
AIRTABLE_FIELD_PASSED_TESTS=Passed Tests
AIRTABLE_FIELD_TEST_RESULTS=Testing Results
# the link from a test row back to its component
AIRTABLE_FIELD_COMPONENT_LINK=Composed in
AIRTABLE_FIELD_EXPECTED_RESULTS=Expected Results
AIRTABLE_FIELD_SUGGESTION=Suggestion for Improvement

# --- Asana ---
# asana.com > Settings > Apps > Personal access token
ASANA_TOKEN=
# from the Asana API, or the URL of your workspace
ASANA_WORKSPACE_ID=
# the board where the crew creates component tasks
ASANA_PROJECT_ID=
# Who plays each role, an Asana user gid or an email Asana knows (a person or a bot account).
# A role left blank opens its subtask unassigned rather than failing.
ASANA_AGENT_ENGINEER=
ASANA_AGENT_QA=
ASANA_AGENT_DEVOPS=
ASANA_AGENT_MANAGER=

# --- Figma ---
# figma.com > Settings > Personal access tokens (the per-component node URL lives in the Airtable row).
# Only used by the hosted MCP server below. The local one needs no token.
FIGMA_TOKEN=
# Which MCP server the engineer reads the design through.
#
#   http://127.0.0.1:3845/mcp   the Dev Mode server the Figma desktop app runs
#                               on this machine. Needs no token, and needs the
#                               app open. This is the one that works.
#   https://mcp.figma.com/mcp   the hosted server, and the default. It refuses
#                               a personal access token: sent as a Bearer it
#                               replies "figd_ tokens must be passed via
#                               X-Figma-Token header", and sent that way it
#                               returns 401. It wants an OAuth flow the crew
#                               does not do.
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp
# The design system's Figma file. Optional: each component carries its own node URL.
FIGMA_FILE_KEY=

# --- Design system repo the crew builds into ---
# local path or git url of the design system repo
REPO_PATH_OR_URL=
REPO_STAGING_BRANCH=staging
REPO_MAIN_BRANCH=main
# owner/repo, only when the path above is local. Used to confirm a commit resolves.
# Without it a commit can never become evidence, whatever the worker built.
GITHUB_REPO=
# How this repo puts a branch on staging. Left blank, DevOps reads the repo's
# own scripts and CI config to find the path, and says so if it has none.
REPO_STAGE_COMMAND=
# How production is deployed. Run by the gated step alone, never by a worker.
# With nothing here, nothing can be deployed, which is the safe way round.
REPO_PRODUCTION_COMMAND=
# Where a component lives in production. {slug} is the component slug.
# Left blank, the production URL is read out of the deploy output.
REPO_PRODUCTION_URL_TEMPLATE=

# --- Keys ---
# Optional, and it decides who pays for the workers.
# Set it, and every worker spends metered API credit from console.anthropic.com.
# Leave it out, and every worker runs on the Claude Code sign-in of whoever
# runs the sweep, on their subscription. A Claude plan and API credit are two
# separate meters: neither one tops up the other.
ANTHROPIC_API_KEY=
# GitHub > Settings > Developer settings > Personal access token, read-only
GITHUB_TOKEN=
# chromatic.com > your project > Manage
CHROMATIC_TOKEN=
# npmjs.com > Access Tokens, publish scope
NPM_TOKEN=
# Where the library is published. The public registry unless you say otherwise.
NPM_REGISTRY=https://registry.npmjs.org
# What the gated step runs to publish. Set it to "npm publish --dry-run" to
# exercise the whole gated path without putting a package on the registry.
NPM_PUBLISH_COMMAND=npm publish

# --- Docs, the Astro Starlight site ---
# Where a component page is written.
DOCS_PATH=
# Where that page appears once the site is built. {slug} is the component slug.
DOCS_URL_TEMPLATE=
# How the docs site is built and published, when it has its own path.
DOCS_DEPLOY_COMMAND=

# --- Workers ---
# Which meter a worker spends.
#   subscription  the default. No API key reaches a worker, even if one is set
#                 above, and it runs on the Claude Code sign-in of whoever
#                 started the sweep.
#   api-key       hands the worker ANTHROPIC_API_KEY and bills the console
#                 account. Also turns on --bare, which only works that way.
WORKER_AUTH=subscription
# What every worker runs as. The CLI's own default when unset. Pinning it
# matters on a subscription, where the window is the thing being spent.
WORKER_MODEL=
# A ceiling on every delegation, in minutes. Each lane has its own, sized to
# its craft; this lowers any that are longer and raises none.
WORKER_MAX_MINUTES=
